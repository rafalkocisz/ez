## Commands

```sh
# Configure + build (normal)
cmake -B build && cmake --build build

# Run tests
ctest --test-dir build

# Sanitizer build (Clang, WSL2/Linux)
cmake -B build-san -DEZ<NAME>_SANITIZE=ON -DCMAKE_CXX_COMPILER=clang++
cmake --build build-san && ./build-san/tests/test_ez_<name>

# Fuzz build (Clang, WSL2/Linux)
cmake -B build-fuzz -DEZ<NAME>_BUILD_FUZZ=ON -DCMAKE_CXX_COMPILER=clang++
cmake --build build-fuzz
./build-fuzz/fuzz/fuzz_ez_<name> fuzz/corpus/ -runs=500000
```

